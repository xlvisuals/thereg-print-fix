{
  "manifest_version": 2,
  "name": "Print El Reg",
  "version": "1.1",
  "description": "Fixes print styles on theregister.com and opens the print dialog.",
  "browser_specific_settings": {
    "gecko": {
      "id": "thereg-print-fix@local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": []
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": [
    "activeTab"
  ],
  "browser_action": {
    "default_icon": "icon.png",
    "default_title": "Print El Reg page"
  },
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "icons": {
    "48": "icon.png"
  }
}
